{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('Pretix vouchers') }}{% endblock %}

{% block content %}
    <div class="container">
        <h1>{{ block('title') }}</h1>

        {% include 'layouts/parts/messages.twig' %}

        <form method="post" action="{{ url('/admin/pretix/settings') }}">
            {{ csrf() }}

            <div class="row">
                <div class="col-md-6">
                    <h2>{{ __('Vouchers') }}</h2>

                    {{ f.switch('enable_pretix_voucher', __('Automatically issue Pretix vouchers'), {
                        'checked': enablePretixVoucher,
                    }) }}

                    {{ f.input('pretix_redeem_link', __('Pretix redeem link'), {
                        'value': pretixRedeemLink,
                        'placeholder': 'https://tickets.example.com/redeem?voucher={code}',
                        'info': __('Use {code} as placeholder, it will be replaced with the actual voucher code.'),
                    }) }}

                    {% if pretixRedeemLink %}
                        <div class="form-text mb-3">
                            {{ __('Preview with an example code:') }}
                            <a href="{{ examplePreview }}" target="_blank" rel="noopener">{{ examplePreview }}</a>
                        </div>
                    {% endif %}

                    {{ f.number('pretix_min_hours', __('Minimum rostered hours for a voucher'), {
                        'value': pretixMinHours,
                        'min': 0,
                        'step': 0.5,
                        'info': __('As soon as a helper is signed up for at least this many hours (across all their shifts), they automatically get a voucher code and an email.'),
                    }) }}

                    {{ f.input('pretix_admin_notify_email', __('Admin notification email'), {
                        'type': 'email',
                        'value': pretixAdminNotifyEmail,
                        'info': __('Gets an email once the voucher pool actually runs out. Leave empty to disable.'),
                    }) }}

                    {{ f.number('pretix_voucher_low_stock_threshold', __('Low stock warning threshold'), {
                        'value': pretixVoucherLowStockThreshold,
                        'min': 0,
                        'info': __('Show a warning banner on this page once the unused code count drops to or below this number.'),
                    }) }}
                </div>

                <div class="col-md-6">
                    <h2>{{ __('Ticket refunds') }}</h2>

                    {{ f.switch('enable_pretix_refund', __('Automatically create Pretix refunds'), {
                        'checked': enablePretixRefund,
                    }) }}

                    {{ f.switch('pretix_test_mode', __('Test mode (log only, no real Pretix refunds are created)'), {
                        'checked': pretixTestMode,
                        'warning': __('Keep this on until you have verified order lookups against real test data.'),
                    }) }}

                    {{ f.number('pretix_refund_min_hours', __('Minimum completed hours for a refund'), {
                        'value': pretixRefundMinHours,
                        'min': 0,
                        'step': 0.5,
                        'info': __('As soon as a helper has completed ("Schicht geleistet") at least this many hours, a manual refund is created in Pretix for their order.'),
                    }) }}

                    <p class="form-text">
                        {{ __('Only payment method "bank transfer" is supported: refunds are created in Pretix as pending (provider "manual") and still need to be paid out by hand, then marked done in Pretix — helfisystem then automatically marks the helper as paid.') }}
                    </p>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-12">
                    <h2>{{ __('Pretix API connection') }}</h2>

                    <div class="row">
                        <div class="col-md-6">
                            {{ f.input('pretix_base_url', __('Pretix base URL'), {
                                'value': pretixBaseUrl,
                                'placeholder': 'https://tickets.saunasplash.de',
                            }) }}
                        </div>
                        <div class="col-md-3">
                            {{ f.input('pretix_organizer_slug', __('Organizer slug'), {
                                'value': pretixOrganizerSlug,
                            }) }}
                        </div>
                        <div class="col-md-3">
                            {{ f.input('pretix_event_slug', __('Event slug'), {
                                'value': pretixEventSlug,
                            }) }}
                        </div>
                    </div>

                    {{ f.input('pretix_api_token', __('API token'), {
                        'type': 'password',
                        'value': pretixApiTokenSet ? passwordPlaceholder : '',
                        'placeholder': pretixApiTokenSet ? '' : __('Not set'),
                        'info': __('Create a team API token in Pretix with "can change orders" permission. Leave unchanged to keep the current token.'),
                    }) }}

                    <h3 class="mt-3">{{ __('Checkout question IDs for bank details') }}</h3>
                    <p class="form-text">
                        {{ __('The "identifier" field of the Pretix checkout questions that hold account holder name, IBAN and BIC (Pretix admin → Questions).') }}
                    </p>
                    <div class="row">
                        <div class="col-md-4">
                            {{ f.input('pretix_account_holder_question_id', __('Account holder question ID'), {
                                'value': pretixAccountHolderQuestionId,
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ f.input('pretix_iban_question_id', __('IBAN question ID'), {
                                'value': pretixIbanQuestionId,
                            }) }}
                        </div>
                        <div class="col-md-4">
                            {{ f.input('pretix_bic_question_id', __('BIC question ID'), {
                                'value': pretixBicQuestionId,
                            }) }}
                        </div>
                    </div>
                </div>
            </div>

            {{ f.save(__('form.save')) }}
        </form>

        <hr class="my-4">

        <div class="row">
            <div class="col-md-6">
                <h2>{{ __('Voucher code pool') }}</h2>

                {% if unusedCount == 0 %}
                    {{ m.alert(__('Voucher pool is empty! Helpers who reach the threshold will not get a code until you add more below.'), 'danger') }}
                {% elseif unusedCount <= pretixVoucherLowStockThreshold %}
                    {{ m.alert(__('Only %d unused codes left, add more soon.', [unusedCount]), 'warning') }}
                {% endif %}

                <p>
                    {{ __('%d unused codes, %d already assigned.', [unusedCount, usedCount]) }}
                </p>

                <form method="post" action="{{ url('/admin/pretix/codes') }}">
                    {{ csrf() }}

                    {{ f.textarea('codes', __('Add voucher codes (one per line)'), {
                        'rows': 10,
                        'placeholder': "CODE-0001\nCODE-0002\nCODE-0003",
                        'info': __('Codes already in the pool are skipped automatically.'),
                    }) }}

                    {{ f.submit(__('Add codes'), {'icon_left': 'plus-lg'}) }}
                </form>

                {% if recentlyUsed|length %}
                    <h3 class="mt-4">{{ __('Recently assigned') }}</h3>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>{{ __('general.name') }}</th>
                                <th>{{ __('Code') }}</th>
                                <th>{{ __('general.date') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for voucher in recentlyUsed %}
                                <tr>
                                    <td>{{ voucher.usedBy ? m.user(voucher.usedBy) : '-' }}</td>
                                    <td>{{ voucher.code }}</td>
                                    <td>{{ voucher.used_at ? voucher.used_at.format(__('general.date')) : '-' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

            <div class="col-md-6">
                <h2>{{ __('Tracked refunds') }}</h2>
                {% if refunds|length %}
                    <p>
                        <a class="btn btn-secondary btn-sm" href="{{ url('/admin/pretix/refunds.csv') }}">
                            {{ m.icon('download') }} {{ __('Download CSV for bulk bank transfer') }}
                        </a>
                    </p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>{{ __('general.name') }}</th>
                                <th>{{ __('Order') }}</th>
                                <th>{{ __('Amount') }}</th>
                                <th>{{ __('IBAN') }}</th>
                                <th>{{ __('Status') }}</th>
                                <th>{{ __('general.date') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for refund in refunds %}
                                <tr>
                                    <td>{{ refund.user ? m.user(refund.user) : '-' }}</td>
                                    <td>{{ refund.order_code }}</td>
                                    <td>{{ refund.amount }}&nbsp;€</td>
                                    <td>{{ refund.iban ?: '—' }}</td>
                                    <td>{{ refund.state }}</td>
                                    <td>{{ refund.created_at ? refund.created_at.format(__('general.date')) : '-' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="text-muted">{{ __('No refunds tracked yet.') }}</p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
