{% extends 'layouts/app.twig' %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('iban.form.title') }}{% endblock %}

{% block content %}
    <div class="container">
        <meta name="robots" content="noindex,nofollow,noarchive">
        <h1>{{ __('iban.form.title') }}</h1>

        {% include 'layouts/parts/messages.twig' %}

        <div class="row">
            <div class="col-md-8">
                <p>{{ __('iban.form.intro', [order_code]) }}</p>
                <form action="" method="post" autocomplete="off">
                    {{ csrf() }}

                    {{ f.input('account_holder', __('iban.form.holder'), {
                        'required': true,
                        'value': account_holder|default(''),
                        'max_length': 100,
                    }) }}
                    {{ f.input('iban', __('iban.form.iban'), {
                        'required': true,
                        'value': iban|default(''),
                        'max_length': 42,
                    }) }}
                    {{ f.input('bic', __('iban.form.bic'), {
                        'value': bic|default(''),
                        'max_length': 11,
                        'info': __('iban.form.bic.info'),
                    }) }}

                    {{ f.submit(__('iban.form.submit')) }}
                </form>
                <p class="text-muted mt-3">{{ __('iban.form.privacy') }}</p>
            </div>
        </div>
    </div>
{% endblock %}
