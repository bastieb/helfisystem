#!/usr/bin/env php
<?php

declare(strict_types=1);

use Carbon\Carbon;
use Engelsystem\Config\Config;
use Engelsystem\Helpers\IbanValidator;
use Engelsystem\Helpers\PretixClient;
use Engelsystem\Mail\EngelsystemMailer;
use Engelsystem\Models\PretixIbanRequest;
use Engelsystem\Models\PretixRefund;
use Engelsystem\Models\PretixVoucher;
use Engelsystem\Models\Shifts\ShiftEntry;
use Engelsystem\Models\User\PersonalData;
use Engelsystem\Models\User\User;
use Psr\Log\LoggerInterface;

require_once __DIR__ . '/../includes/application.php';

/** @var Config $config */
$config = app(Config::class);

if (!$config->get('enable_pretix_refund')) {
    echo 'Pretix refund automation is disabled (enable_pretix_refund), nothing to do.' . PHP_EOL;
    exit(0);
}

$minHours = (float) $config->get('pretix_refund_min_hours', 0);
$testMode = (bool) $config->get('pretix_test_mode', true);

/** @var LoggerInterface $log */
$log = app(LoggerInterface::class);
/** @var PretixClient $pretix */
$pretix = app(PretixClient::class);

if (!$pretix->isConfigured()) {
    echo 'Pretix API is not fully configured yet (base URL/organizer/event/token), nothing to do.' . PHP_EOL;
    exit(0);
}

echo $testMode ? '=== TEST MODE: no real Pretix writes will happen ===' . PHP_EOL : '';

detectNewRefunds($minHours, $testMode, $pretix, $log, $config);
syncPendingRefunds($testMode, $pretix, $log);

function detectNewRefunds(float $minHours, bool $testMode, PretixClient $pretix, LoggerInterface $log, Config $config): void
{
    // Gleiche Logik wie die "Summe geleisteter Stunden"-Spalte in der Benutzerliste:
    // nur Schichten mit shift_completed=1 zaehlen. helfisystem: Pro-User-Override
    // (users_personal_data.refund_hours_override) erlaubt Admin-Ausnahmen mit
    // abweichender Mindeststundenzahl (z.B. bei manuell zugewiesenen Vouchern ausserhalb
    // des normalen Schemas), unabhaengig vom globalen pretix_refund_min_hours.
    $completedHours = ShiftEntry::query()
        ->join('shifts', 'shifts.id', '=', 'shift_entries.shift_id')
        ->where('shift_entries.shift_completed', 1)
        ->selectRaw(
            'shift_entries.user_id as user_id, '
            . 'COALESCE(SUM(TIMESTAMPDIFF(SECOND, shifts.start, shifts.end)), 0) / 3600 as hours'
        )
        ->groupBy('shift_entries.user_id')
        ->pluck('hours', 'user_id');

    if ($completedHours->isEmpty()) {
        echo 'No helpers have any completed shifts yet.' . PHP_EOL;

        return;
    }

    $overrides = PersonalData::query()
        ->whereIn('user_id', $completedHours->keys())
        ->whereNotNull('refund_hours_override')
        ->pluck('refund_hours_override', 'user_id');

    // helfisystem: Tagesticket-Deal (Voucher aus einem day_*-Pool) hat eine eigene, niedrigere
    // Mindeststundenzahl (pretix_refund_min_hours_day, Default 3h). Reihenfolge der Schwelle:
    // Pro-User-Override > Tagesticket-Schwelle (bei Tagesticket-Voucher) > globale Schwelle.
    $dayMinHours = (float) $config->get('pretix_refund_min_hours_day', 3);
    $dayTicketUserIds = PretixVoucher::query()
        ->whereIn('used_by_user_id', $completedHours->keys())
        ->where('pool', '!=', PretixVoucher::POOL_FULL)
        ->pluck('used_by_user_id')
        ->flip();

    $eligibleUserIds = $completedHours->filter(function ($hours, $userId) use ($overrides, $minHours, $dayMinHours, $dayTicketUserIds) {
        $baseThreshold = $dayTicketUserIds->has($userId) ? $dayMinHours : $minHours;
        $threshold = (float) $overrides->get($userId, $baseThreshold);

        return $threshold > 0 && $hours >= $threshold;
    })->keys();

    if ($eligibleUserIds->isEmpty()) {
        echo 'No helpers reached the required completed hours yet.' . PHP_EOL;

        return;
    }

    $alreadyTrackedUserIds = PretixRefund::query()->pluck('user_id');

    $candidates = User::query()
        ->whereIn('id', $eligibleUserIds)
        ->whereNotIn('id', $alreadyTrackedUserIds)
        ->whereHas('personalData', fn ($query) => $query
            ->where('has_payday', false)
            ->where('voucher_code', '!=', ''))
        ->with('personalData')
        ->get();

    if ($candidates->isEmpty()) {
        echo 'No new refund candidates (either no voucher/order link, already paid, or already tracked).' . PHP_EOL;

        return;
    }

    foreach ($candidates as $user) {
        try {
            processCandidate($user, $testMode, $pretix, $log, $config);
        } catch (\Throwable $e) {
            $log->error(
                'Pretix refund check failed for {name} ({id}): {message}',
                ['name' => $user->name, 'id' => $user->id, 'message' => $e->getMessage()]
            );
            echo sprintf('ERROR %s: %s (skipped, continuing with next helper)', $user->name, $e->getMessage()) . PHP_EOL;
        }
    }
}

function processCandidate(User $user, bool $testMode, PretixClient $pretix, LoggerInterface $log, Config $config): void
{
    $voucherCode = $user->personalData->voucher_code;

    $orderCode = $pretix->findOrderCodeByVoucher($voucherCode);
    if (!$orderCode) {
        $log->warning(
            'Pretix refund check: no order found for voucher {code} ({name}, {id})',
            ['code' => $voucherCode, 'name' => $user->name, 'id' => $user->id]
        );
        echo sprintf('SKIP %s: no Pretix order found for voucher %s', $user->name, $voucherCode) . PHP_EOL;

        return;
    }

    $order = $pretix->getOrder($orderCode);
    if (!$order || ($order['status'] ?? null) !== 'p') {
        echo sprintf(
            'SKIP %s: order %s is not paid (status=%s)',
            $user->name,
            $orderCode,
            $order['status'] ?? 'unknown'
        ) . PHP_EOL;

        return;
    }

    $outstanding = round((float) $order['total'] - $pretix->refundedAmount($order), 2);
    if ($outstanding <= 0) {
        echo sprintf('SKIP %s: order %s has nothing left to refund', $user->name, $orderCode) . PHP_EOL;

        return;
    }

    // helfisystem: Das Ticket ist ein Pfand in Hoehe des dem Voucher-Pool entsprechenden
    // Ticketpreises, nicht in Hoehe des tatsaechlich bezahlten Betrags. Wer z.B. seinen
    // Tagesticket-Voucher fuer ein Wochenendticket einsetzt (Pretix zeigt wegen
    // show_hidden_items=true den ganzen Shop, nicht nur das zugeteilte Ticket), zahlt den
    // Aufpreis selbst - die Erstattung bleibt auf den Tagesticket-Preis gedeckelt.
    $priceCap = refundPriceCapFor($user, $config);
    if ($priceCap !== null && $outstanding > $priceCap) {
        $log->warning(
            'Pretix refund check: capping refund for {name} ({id}) from {paid} EUR to {cap} EUR '
            . '(order {order} total exceeds the voucher pool\'s ticket price - likely upgraded to a pricier ticket)',
            ['name' => $user->name, 'id' => $user->id, 'paid' => $outstanding, 'cap' => $priceCap, 'order' => $orderCode]
        );
        echo sprintf(
            'NOTE %s: order %s total is %.2f EUR, capped refund to %.2f EUR (voucher pool ticket price)',
            $user->name,
            $orderCode,
            $outstanding,
            $priceCap
        ) . PHP_EOL;
        $outstanding = $priceCap;
    }

    $bankDetails = resolveBankDetails($user, $orderCode, $order, $testMode, $pretix, $log);
    if ($bankDetails === null) {
        return;
    }

    if ($testMode) {
        echo sprintf(
            'WOULD REFUND %s: order %s, amount %.2f EUR, account holder=%s, IBAN=%s, BIC=%s (test mode, nothing created)',
            $user->name,
            $orderCode,
            $outstanding,
            $bankDetails['account_holder'] ?? '-',
            $bankDetails['iban'] ?? '-',
            $bankDetails['bic'] ?? '-'
        ) . PHP_EOL;

        return;
    }

    $refund = $pretix->createManualRefund(
        $orderCode,
        $outstanding,
        'helfisystem: Erstattung nach abgeleisteten Schichten',
        $bankDetails
    );

    PretixRefund::query()->create([
        'user_id' => $user->id,
        'order_code' => $orderCode,
        'pretix_refund_local_id' => $refund['local_id'],
        'amount' => $outstanding,
        'account_holder' => $bankDetails['account_holder'],
        'iban' => $bankDetails['iban'],
        'bic' => $bankDetails['bic'],
        'state' => $refund['state'] ?? 'created',
        'synced_at' => new Carbon(),
    ]);

    $log->info(
        'Created Pretix refund for {name} ({id}): order {order}, {amount} EUR',
        ['name' => $user->name, 'id' => $user->id, 'order' => $orderCode, 'amount' => $outstanding]
    );
    echo sprintf('CREATED refund for %s: order %s, %.2f EUR (pending, needs manual bank transfer)', $user->name, $orderCode, $outstanding) . PHP_EOL;
}

/**
 * helfisystem: Liefert gueltige Bankdaten fuer die Erstattung oder null (dann wird uebersprungen).
 * Reihenfolge: 1. vom Helfi per Link nachgetragene IBAN, 2. IBAN aus der Pretix-Bestellung (nur wenn
 * formal gueltig), 3. sonst wird der Helfi per Mail mit einem sicheren Einmal-Link um eine IBAN gebeten.
 *
 * @return array{account_holder: ?string, iban: ?string, bic: ?string}|null
 */
function resolveBankDetails(
    User $user,
    string $orderCode,
    array $order,
    bool $testMode,
    PretixClient $pretix,
    LoggerInterface $log
): ?array {
    $submitted = PretixIbanRequest::query()
        ->where('user_id', $user->id)
        ->where('order_code', $orderCode)
        ->where('status', PretixIbanRequest::STATUS_SUBMITTED)
        ->latest('submitted_at')
        ->first();

    if ($submitted && IbanValidator::isValid($submitted->iban) && $submitted->account_holder) {
        return [
            'account_holder' => $submitted->account_holder,
            'iban' => IbanValidator::normalize($submitted->iban),
            'bic' => normalizeBic($submitted->bic),
        ];
    }

    $bankDetails = $pretix->extractBankDetails($order);
    $ibanError = IbanValidator::error($bankDetails['iban']);

    if ($ibanError === null && $bankDetails['account_holder']) {
        $bankDetails['iban'] = IbanValidator::normalize($bankDetails['iban']);
        $bankDetails['bic'] = normalizeBic($bankDetails['bic'] ?? null);

        return $bankDetails;
    }

    // Fehlende/ungueltige IBAN -> Helfi um korrigierte IBAN bitten
    $reason = $ibanError === 'empty' ? 'missing' : 'invalid';
    if ($ibanError === null) {
        $reason = 'missing'; // IBAN ok, aber Kontoinhaber fehlt
    }

    requestIban($user, $orderCode, $reason, $testMode, $log);

    return null;
}

/**
 * helfisystem: BIC fuer den SEPA-XML-Export normalisieren. Helfis tippen die BIC im Pretix-Formular teils klein
 * oder gemischt ein (z.B. "Ingddeff"); Pretix reicht sie 1:1 in die XML durch, das SEPA-Schema verlangt aber
 * Grossbuchstaben (sonst 500er beim Export). Formal ungueltige BIC -> null (im SEPA-Raum optional).
 */
function normalizeBic(?string $bic): ?string
{
    $bic = strtoupper(preg_replace('/\s+/', '', (string) $bic));

    return preg_match('/^[A-Z]{6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3})?$/', $bic) === 1 ? $bic : null;
}

function requestIban(User $user, string $orderCode, string $reason, bool $testMode, LoggerInterface $log): void
{
    $maxRequests = 3;
    $reminderDays = (int) config('pretix_iban_reminder_days', 3);
    $maxReminders = (int) config('pretix_iban_max_reminders', 2);
    $validDays = (int) config('pretix_iban_link_valid_days', 14);

    $requests = PretixIbanRequest::query()
        ->where('user_id', $user->id)
        ->where('order_code', $orderCode)
        ->orderBy('id')
        ->get();

    $pending = $requests->firstWhere('status', PretixIbanRequest::STATUS_PENDING);

    if ($pending && $pending->failed_attempts >= PretixIbanRequest::MAX_FAILED_ATTEMPTS) {
        echo sprintf('SKIP %s: IBAN link locked after too many invalid attempts (needs manual handling)', $user->name) . PHP_EOL;

        return;
    }

    if ($pending && $pending->expires_at->isPast()) {
        if (!$testMode) {
            $pending->status = PretixIbanRequest::STATUS_EXPIRED;
            $pending->save();
        }
        $pending = null;
        $requests = $requests->reject(fn ($r) => $r->status === PretixIbanRequest::STATUS_PENDING);
    }

    if ($pending) {
        $lastContact = $pending->last_reminder_at ?? $pending->sent_at;
        $due = $lastContact && $lastContact->copy()->addDays($reminderDays)->isPast();

        if (!$due || $pending->reminders_sent >= $maxReminders) {
            echo sprintf('SKIP %s: waiting for IBAN via link (sent %s)', $user->name, $pending->sent_at?->toDateString() ?? '-') . PHP_EOL;

            return;
        }

        if ($testMode) {
            echo sprintf('WOULD REMIND %s about IBAN link (reminder %d, test mode, no mail sent)', $user->name, $pending->reminders_sent + 1) . PHP_EOL;

            return;
        }

        // Token wird nur gehasht gespeichert -> fuer die Erinnerung ein neuer Link, der alte wird ungueltig
        $token = bin2hex(random_bytes(32));
        $pending->token_hash = PretixIbanRequest::hashToken($token);
        $pending->expires_at = Carbon::now()->addDays($validDays);
        $pending->reminders_sent++;
        $pending->last_reminder_at = Carbon::now();
        $pending->save();
        sendIbanMail($user, $pending, $token, $reason);
        $log->info('IBAN reminder sent to {name} ({id})', ['name' => $user->name, 'id' => $user->id]);
        echo sprintf('REMINDED %s about IBAN link', $user->name) . PHP_EOL;

        return;
    }

    if ($requests->count() >= $maxRequests) {
        echo sprintf('SKIP %s: IBAN link requested %d times without result (needs manual handling)', $user->name, $requests->count()) . PHP_EOL;

        return;
    }

    if ($testMode) {
        echo sprintf('WOULD REQUEST IBAN from %s: order %s, reason=%s (test mode, no mail sent)', $user->name, $orderCode, $reason) . PHP_EOL;

        return;
    }

    $token = bin2hex(random_bytes(32));
    $request = PretixIbanRequest::query()->create([
        'user_id' => $user->id,
        'order_code' => $orderCode,
        'token_hash' => PretixIbanRequest::hashToken($token),
        'status' => PretixIbanRequest::STATUS_PENDING,
        'reason' => $reason,
        'sent_at' => Carbon::now(),
        'expires_at' => Carbon::now()->addDays($validDays),
    ]);

    sendIbanMail($user, $request, $token, $reason);
    $log->info(
        'IBAN request sent to {name} ({id}) for order {order}, reason {reason}',
        ['name' => $user->name, 'id' => $user->id, 'order' => $orderCode, 'reason' => $reason]
    );
    echo sprintf('REQUESTED IBAN from %s: order %s, reason=%s', $user->name, $orderCode, $reason) . PHP_EOL;
}

function sendIbanMail(User $user, PretixIbanRequest $request, string $token, string $reason): void
{
    /** @var EngelsystemMailer $mailer */
    $mailer = app(EngelsystemMailer::class);
    $mailer->sendViewTranslated(
        $user,
        'iban.mail.subject',
        'emails/iban-request',
        [
            'username' => $user->displayName,
            'link' => url('/iban/' . $token),
            'reason_key' => 'iban.mail.reason.' . $reason,
            'valid_until' => $request->expires_at->format('d.m.Y'),
        ]
    );
}

/**
 * helfisystem: Obergrenze fuer die Erstattung, abhaengig vom Voucher-Pool, aus dem der
 * zugewiesene Code stammt (Tagesticket vs. Wochenendticket) - siehe processCandidate().
 * Gibt null zurueck, wenn kein passender Voucher gefunden wird (dann keine Deckelung).
 */
function refundPriceCapFor(User $user, Config $config): ?float
{
    $voucher = PretixVoucher::query()
        ->where('code', $user->personalData->voucher_code)
        ->where('used_by_user_id', $user->id)
        ->first();

    if (!$voucher) {
        return null;
    }

    if ($voucher->pool === PretixVoucher::POOL_FULL) {
        return (float) $config->get('pretix_full_ticket_price', 90);
    }

    return (float) $config->get('pretix_day_ticket_price', 45);
}

function syncPendingRefunds(bool $testMode, PretixClient $pretix, LoggerInterface $log): void
{
    $pending = PretixRefund::query()
        ->whereNotIn('state', ['done', 'canceled'])
        ->whereNotNull('pretix_refund_local_id')
        ->with('user.personalData')
        ->get();

    if ($pending->isEmpty()) {
        echo 'No pending refunds to sync.' . PHP_EOL;

        return;
    }

    if ($testMode) {
        echo sprintf('TEST MODE: would sync %d pending refund(s) against Pretix.', $pending->count()) . PHP_EOL;

        return;
    }

    foreach ($pending as $tracked) {
        try {
            $refund = $pretix->getRefund($tracked->order_code, $tracked->pretix_refund_local_id);
        } catch (\Throwable $e) {
            $log->error(
                'Pretix refund sync failed for order {order}: {message}',
                ['order' => $tracked->order_code, 'message' => $e->getMessage()]
            );
            echo sprintf('ERROR syncing order %s: %s (skipped)', $tracked->order_code, $e->getMessage()) . PHP_EOL;

            continue;
        }

        if (!$refund) {
            continue;
        }

        $newState = $refund['state'] ?? $tracked->state;
        if ($newState === $tracked->state) {
            continue;
        }

        $tracked->state = $newState;
        $tracked->synced_at = new Carbon();
        $tracked->save();

        echo sprintf('SYNCED refund for order %s: state -> %s', $tracked->order_code, $newState) . PHP_EOL;

        if ($newState === 'done' && $tracked->user && $tracked->user->personalData) {
            $tracked->user->personalData->has_payday = true;
            $tracked->user->personalData->save();

            $log->info(
                'Pretix refund for {name} ({id}) is done, marked as paid',
                ['name' => $tracked->user->name, 'id' => $tracked->user->id]
            );
            echo sprintf('MARKED %s as paid (has_payday)', $tracked->user->name) . PHP_EOL;
        }
    }
}
